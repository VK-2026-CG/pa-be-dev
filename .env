# One isolated deployment and MongoDB instance per country.
COUNTRY_CODE="MY"
# MongoDB Atlas — this URI must point only to this country's instance.
MONGODB_URI="mongodb+srv://cg_user:cg%401234@pruforce-dev1.gwzqo2s.mongodb.net/?appName=pruforce-dev1"
MONGODB_PAMB_DB="pa_performance_PAMB-dev"
MONGODB_PBTB_DB="pa_performance_PBTB-dev" # optional source DB override for ingestion/seed readers
MONGODB_CONTEST_DB="contests" # separate logical DB inside the country's isolated instance
MONGODB_CONTEST_URI="" # optional dedicated Contest cluster URI; defaults to MONGODB_URI when empty
MONGODB_AGENT_COLLECTION="my_agent_hierarchy" # source agent master/hierarchy collection name (falls back to production distinct agents if empty/unavailable)
MONGODB_PRODUCTION_COLLECTION="my_production" # source production collection name
NODE_ENV="development"
# Optional source field mapping when production column names differ from defaults.
CONTEST_SEED_BUSINESS_DATE="2026-09-07" # YYYY-MM-DD cutoff used by db:seed:contests
PRODUCTION_FIELD_TENANT="" # blank disables tenant predicate for source rows without tenant column
PRODUCTION_FIELD_AGENT_ID="agent_id"
PRODUCTION_FIELD_TRANSACTION_DATE="asOnDate"
PRODUCTION_FIELD_FYP="snapshot.fyp.total"
PRODUCTION_FIELD_API="ptd.api.ytd"
PRODUCTION_FIELD_CASE_COUNT="snapshot.caseCount.total"

# Optional agent-source field mapping (used only when agent collection has rows).
AGENT_FIELD_TENANT="tenant"
AGENT_FIELD_AGENT_ID="agentId"
AGENT_FIELD_ACTIVE="active"
AGENT_FIELD_RANK="rank"
AGENT_FIELD_REGION="region"
AGENT_FIELD_CHANNEL="channel"
AGENT_FIELD_LEADER_ID="leaderId"

# Required fields in production source rows (after mapping):
# tenant, transactionId, agentId, policyNumber, transactionDate, businessLine,
# productType, fyp, api, caseCount
CONTEST_BROCHURE_STORAGE="azure" # memory is test/development-only
CONTEST_BROCHURE_AZURE_ACCOUNT="<storage-account>"
CONTEST_BROCHURE_AZURE_KEY="<storage-key>"
CONTEST_BROCHURE_AZURE_CONTAINER="contest-brochures-private"
CONTEST_BROCHURE_MAX_BYTES="10485760" # temporary 10 MiB ceiling; may be lowered, never raised above this
CONTEST_AI_PROVIDER="openai" # deterministic is test/development-only; production target is azure-openai
OPENAI_API_KEY="<server-side-secret>"
OPENAI_CONTEST_MODEL="gpt-4.1-mini"
OPENAI_CONTEST_TIMEOUT_MS="60000"
OPENAI_CONTEST_MAX_OUTPUT_TOKENS="12000"
port:"4600"

# Contest development auth is header-based until the OIDC adapter is supplied:
# x-agent-id: A1001
# x-tenant: MY
# x-contest-role: CONTEST_MAKER