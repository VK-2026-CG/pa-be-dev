# Copy to .env only if you need the Mongo profile (`npm run dev`).
# `npm run dev:mock` needs NO .env: it forces the offline stub engine and ignores
# the Mongo settings below. Never commit real URIs, keys or agent allowlists.

COUNTRY_CODE="MY"
NODE_ENV="development"

# --- Mongo (Performance direct source) profile ---
INSIGHTS_DATA_SOURCE=performance
MONGODB_URI="<mongodb+srv://user:pass@cluster/>"
MONGODB_DB="pa_performance_PAMB-dev"
MONGODB_CONTEST_DB="contests"
INSIGHTS_MOCK_AGENTS_FILE=data/performance-mocks/agents.json
# DEV-ONLY (needs NODE_ENV=development): Mongo first; anything Mongo cannot
# supply (EMPTY metrics, detail parts, history, milestones, recommendations,
# team roster, agents with no rows) is filled from the stub engine. See AGENTS.md.
INSIGHTS_DEV_MOCK_FALLBACK=true

# --- Contest (development defaults) ---
CONTEST_BROCHURE_STORAGE="memory"
CONTEST_AI_PROVIDER="deterministic"
