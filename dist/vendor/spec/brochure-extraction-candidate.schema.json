{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://specs.pruaction.internal/domains/contests/import/brochure-extraction-candidate.schema.json",
    "title": "Contest brochure extraction candidate 1.0",
    "$defs": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$", "maxLength": 64 },
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{1,63}$", "maxLength": 64 },
        "decimal": { "type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$", "maxLength": 80 },
        "date": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])$" },
        "citationIds": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/key" } },
        "context": { "type": "object", "additionalProperties": false, "required": ["periodKey", "audienceCode", "aggregationCode", "repricingCode", "productScopeCode"], "properties": { "periodKey": { "anyOf": [{ "$ref": "#/$defs/key" }, { "type": "null" }] }, "audienceCode": { "anyOf": [{ "$ref": "#/$defs/code" }, { "type": "null" }] }, "aggregationCode": { "anyOf": [{ "$ref": "#/$defs/code" }, { "type": "null" }] }, "repricingCode": { "anyOf": [{ "$ref": "#/$defs/code" }, { "type": "null" }] }, "productScopeCode": { "anyOf": [{ "$ref": "#/$defs/code" }, { "type": "null" }] } } },
        "operand": { "oneOf": [
                { "type": "object", "additionalProperties": false, "required": ["kind", "value", "currency"], "properties": { "kind": { "enum": ["DECIMAL", "MONEY", "PERCENT"] }, "value": { "$ref": "#/$defs/decimal" }, "currency": { "anyOf": [{ "type": "string", "pattern": "^[A-Z]{3}$" }, { "type": "null" }] } } },
                { "type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": { "kind": { "const": "INTEGER" }, "value": { "type": "integer" } } },
                { "type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": { "kind": { "const": "BOOLEAN" }, "value": { "type": "boolean" } } },
                { "type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": { "kind": { "const": "DATE" }, "value": { "$ref": "#/$defs/date" } } },
                { "type": "object", "additionalProperties": false, "required": ["kind", "from", "to"], "properties": { "kind": { "const": "DATE_RANGE" }, "from": { "$ref": "#/$defs/date" }, "to": { "$ref": "#/$defs/date" } } },
                { "type": "object", "additionalProperties": false, "required": ["kind", "from", "to", "currency"], "properties": { "kind": { "const": "RANGE" }, "from": { "$ref": "#/$defs/decimal" }, "to": { "$ref": "#/$defs/decimal" }, "currency": { "anyOf": [{ "type": "string", "pattern": "^[A-Z]{3}$" }, { "type": "null" }] } } },
                { "type": "object", "additionalProperties": false, "required": ["kind", "lovKey", "valueCode"], "properties": { "kind": { "const": "LOV" }, "lovKey": { "type": "string", "maxLength": 80 }, "valueCode": { "$ref": "#/$defs/code" } } },
                { "type": "object", "additionalProperties": false, "required": ["kind", "lovKey", "valueCodes"], "properties": { "kind": { "const": "LOV_SET" }, "lovKey": { "type": "string", "maxLength": 80 }, "valueCodes": { "type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": { "$ref": "#/$defs/code" } } } }
            ] },
        "predicate": { "type": "object", "additionalProperties": false, "required": ["nodeKey", "type", "metricCode", "operator", "operand", "context", "sourceCitationIds"], "properties": { "nodeKey": { "$ref": "#/$defs/key" }, "type": { "const": "PREDICATE" }, "metricCode": { "$ref": "#/$defs/code" }, "operator": { "enum": ["GTE", "GT", "LTE", "LT", "EQ", "NEQ", "IN", "NOT_IN", "BETWEEN", "EXISTS"] }, "operand": { "anyOf": [{ "$ref": "#/$defs/operand" }, { "type": "null" }] }, "context": { "$ref": "#/$defs/context" }, "sourceCitationIds": { "$ref": "#/$defs/citationIds" } } },
        "all": { "type": "object", "additionalProperties": false, "required": ["nodeKey", "type", "children"], "properties": { "nodeKey": { "$ref": "#/$defs/key" }, "type": { "const": "ALL" }, "children": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "#/$defs/expression" } } } },
        "any": { "type": "object", "additionalProperties": false, "required": ["nodeKey", "type", "minimumPass", "children"], "properties": { "nodeKey": { "$ref": "#/$defs/key" }, "type": { "const": "ANY" }, "minimumPass": { "type": "integer", "minimum": 1, "maximum": 200 }, "children": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "#/$defs/expression" } } } },
        "not": { "type": "object", "additionalProperties": false, "required": ["nodeKey", "type", "child"], "properties": { "nodeKey": { "$ref": "#/$defs/key" }, "type": { "const": "NOT" }, "child": { "$ref": "#/$defs/expression" } } },
        "expression": { "oneOf": [{ "$ref": "#/$defs/all" }, { "$ref": "#/$defs/any" }, { "$ref": "#/$defs/not" }, { "$ref": "#/$defs/predicate" }] },
        "citation": { "type": "object", "additionalProperties": false, "required": ["citationId", "page", "section", "evidenceExcerpt", "confidence"], "properties": { "citationId": { "$ref": "#/$defs/key" }, "page": { "type": "integer", "minimum": 1, "maximum": 10000 }, "section": { "type": "string", "minLength": 1, "maxLength": 160 }, "evidenceExcerpt": { "type": "string", "minLength": 1, "maxLength": 1000 }, "confidence": { "enum": ["HIGH", "MEDIUM", "LOW"] } } }
    },
    "type": "object", "additionalProperties": false,
    "required": ["schemaVersion", "document", "basics", "periods", "audiences", "qualificationRoutes", "tiers", "targets", "calculationRules", "rewards", "governance", "trackingRules", "exclusions", "citations", "unresolvedItems"],
    "properties": {
        "schemaVersion": { "const": "1.0" },
        "document": { "type": "object", "additionalProperties": false, "required": ["title", "contestCodeCandidate", "effectiveDate"], "properties": { "title": { "type": "string", "minLength": 1, "maxLength": 200 }, "contestCodeCandidate": { "anyOf": [{ "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,39}$" }, { "type": "null" }] }, "effectiveDate": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] } } },
        "basics": { "type": "object", "additionalProperties": false, "required": ["name", "campaignStart", "campaignEnd", "sourceCitationIds"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 200 }, "campaignStart": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] }, "campaignEnd": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] }, "sourceCitationIds": { "$ref": "#/$defs/citationIds" } } },
        "periods": { "type": "array", "maxItems": 100, "items": { "type": "object", "additionalProperties": false, "required": ["periodKey", "name", "from", "to", "sourceCitationIds"], "properties": { "periodKey": { "$ref": "#/$defs/key" }, "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "from": { "$ref": "#/$defs/date" }, "to": { "$ref": "#/$defs/date" }, "sourceCitationIds": { "$ref": "#/$defs/citationIds" } } } },
        "audiences": { "type": "array", "maxItems": 100, "items": { "type": "object", "additionalProperties": false, "required": ["audienceCode", "rankCodes", "include", "sourceCitationIds"], "properties": { "audienceCode": { "$ref": "#/$defs/code" }, "rankCodes": { "type": "array", "maxItems": 50, "uniqueItems": true, "items": { "$ref": "#/$defs/code" } }, "include": { "type": "boolean" }, "sourceCitationIds": { "$ref": "#/$defs/citationIds" } } } },
        "qualificationRoutes": { "type": "array", "maxItems": 100, "items": { "type": "object", "additionalProperties": false, "required": ["routeKey", "name", "audienceCode", "tierKeys", "expression", "sourceCitationIds"], "properties": { "routeKey": { "$ref": "#/$defs/key" }, "name": { "type": "string", "minLength": 1, "maxLength": 160 }, "audienceCode": { "$ref": "#/$defs/code" }, "tierKeys": { "type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": { "$ref": "#/$defs/key" } }, "expression": { "$ref": "#/$defs/expression" }, "sourceCitationIds": { "$ref": "#/$defs/citationIds" } } } },
        "tiers": { "type": "array", "maxItems": 100, "items": { "type": "object", "additionalProperties": false, "required": ["tierKey", "name", "rewardCode", "sourceCitationIds"], "properties": { "tierKey": { "$ref": "#/$defs/key" }, "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "rewardCode": { "$ref": "#/$defs/code" }, "sourceCitationIds": { "$ref": "#/$defs/citationIds" } } } },
        "targets": { "type": "array", "maxItems": 1000, "items": { "type": "object", "additionalProperties": false, "required": ["tierKey", "periodKey", "state", "value", "sourceCitationIds"], "properties": { "tierKey": { "$ref": "#/$defs/key" }, "periodKey": { "$ref": "#/$defs/key" }, "state": { "enum": ["EXPLICIT", "NOT_APPLICABLE", "NOT_CONFIGURED"] }, "value": { "anyOf": [{ "$ref": "#/$defs/decimal" }, { "type": "null" }] }, "sourceCitationIds": { "$ref": "#/$defs/citationIds" } } } },
        "calculationRules": { "type": "array", "maxItems": 200, "items": { "type": "object", "additionalProperties": false, "required": ["ruleKey", "metricCode", "productCode", "rate", "include", "sourceCitationIds"], "properties": { "ruleKey": { "$ref": "#/$defs/key" }, "metricCode": { "$ref": "#/$defs/code" }, "productCode": { "$ref": "#/$defs/code" }, "rate": { "$ref": "#/$defs/decimal" }, "include": { "type": "boolean" }, "sourceCitationIds": { "$ref": "#/$defs/citationIds" } } } },
        "rewards": { "type": "array", "maxItems": 100, "items": { "type": "object", "additionalProperties": false, "required": ["rewardCode", "name", "sourceCitationIds"], "properties": { "rewardCode": { "$ref": "#/$defs/code" }, "name": { "type": "string", "minLength": 1, "maxLength": 160 }, "sourceCitationIds": { "$ref": "#/$defs/citationIds" } } } },
        "governance": { "type": "object", "additionalProperties": false, "required": ["calculationFrequencyCode", "approvalRouteCode", "sourceCitationIds"], "properties": { "calculationFrequencyCode": { "anyOf": [{ "$ref": "#/$defs/code" }, { "type": "null" }] }, "approvalRouteCode": { "anyOf": [{ "$ref": "#/$defs/code" }, { "type": "null" }] }, "sourceCitationIds": { "$ref": "#/$defs/citationIds" } } },
        "trackingRules": { "type": "array", "maxItems": 100, "items": { "type": "object", "additionalProperties": false, "required": ["ruleKey", "type", "effectiveTo", "actionCode", "sourceCitationIds"], "properties": { "ruleKey": { "$ref": "#/$defs/key" }, "type": { "enum": ["REGISTRATION", "PRODUCTION", "PERSISTENCY", "CONTRACT_STATUS", "SUBMISSION_CUTOFF", "CLAWBACK"] }, "effectiveTo": { "$ref": "#/$defs/date" }, "actionCode": { "$ref": "#/$defs/code" }, "sourceCitationIds": { "$ref": "#/$defs/citationIds" } } } },
        "exclusions": { "type": "array", "maxItems": 100, "items": { "type": "object", "additionalProperties": false, "required": ["exclusionCode", "description", "sourceCitationIds"], "properties": { "exclusionCode": { "$ref": "#/$defs/code" }, "description": { "type": "string", "minLength": 1, "maxLength": 500 }, "sourceCitationIds": { "$ref": "#/$defs/citationIds" } } } },
        "citations": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/citation" } },
        "unresolvedItems": { "type": "array", "maxItems": 500, "items": { "type": "object", "additionalProperties": false, "required": ["path", "reasonCode", "sourceCitationIds"], "properties": { "path": { "type": "string", "pattern": "^/", "maxLength": 500 }, "reasonCode": { "enum": ["NOT_PRESENT_IN_BROCHURE", "AMBIGUOUS_TERM", "CONFLICTING_BROCHURE_TERMS", "UNSUPPORTED_CATALOGUE_VALUE", "MISSING_SOURCE_CITATION", "LOW_CONFIDENCE_MATERIAL_TERM"] }, "sourceCitationIds": { "$ref": "#/$defs/citationIds" } } } }
    }
}
